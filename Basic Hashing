Hashing :  
int arr[] = {1 , 2 , 1 , 3 , 2}
1 appears 2 times 
2 appears 2 times
4 appears 0 times
3 appears 1 times

import java.util.*;
public class Main{
    
    public static int CountFrequency(int arr[],int num){
        int count = 0;
        for(int i = 0; i<arr.length;i++){
            if(arr[i] == num){
                count++;
            }
        }
          return count;
    }
    
    public static void main(String[] args){
        int arr[] = {1 , 2 , 1 , 3 , 2};
        int num = 3;
        
        int result = CountFrequency(arr,num);
        System.out.print(result);
    }
}
