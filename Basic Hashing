import java.util.*;

class FrequencyCounter {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Step 1: Read array size
        int n = sc.nextInt();
        int[] arr = new int[n];

        // Step 2: Read array elements
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        // Step 3: Build frequency map
        HashMap<Integer, Integer> mp = new HashMap<>();

        for (int i = 0; i < n; i++) {
            int key = arr[i];
            // shorter: use getOrDefault instead of manual check
            mp.put(key, mp.getOrDefault(key, 0) + 1);
        }

        // Step 4: Answer queries
        int q = sc.nextInt();
        while (q-- > 0) {
            int number = sc.nextInt();
            // shorter: getOrDefault again for queries
            System.out.println(mp.getOrDefault(number, 0));
        }
    }
}
