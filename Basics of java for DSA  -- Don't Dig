9.OOP Quick Glance :

class Student {
    String name;
    int age;

    Student(String n, int a) {
        name = n;
        age = a;
    }

    void printInfo() {
        System.out.println(name + " " + age);
    }
}

Student s1 = new Student("Madhavan", 21);
s1.printInfo();

