2.Bubble Sort :

import java.util.*;
public class Main{
    public static int[] BubbleSort(int arr[]){
        int n = arr.length;
        for(int i = 0; i<=n-1;i++){
            for(int j= 0; j<n-i-1;j++){
                if(arr[j]>arr[j+1]){
                    int temp = arr[j];
                    arr[j] = arr[j+1];
                    arr[j+1] = temp; 
                }
            }
            
             System.out.println(Arrays.toString(arr));
            
        }
        return arr;
    }
    public static void main(String[] args){
        int arr[] = {5,4,3,2,1};
       int result[] =  BubbleSort(arr);
       System.out.println("Final Array after Sorted using BubbleSort :");
       for(int x:result){
           System.out.print(x + " ");
       }
}

}

🔎 Step-by-Step Execution

Input:

[5, 4, 3, 2, 1]

