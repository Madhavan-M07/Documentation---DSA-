import java.util.*;
public class Main {

    public static int[] Selectionsort(int arr[]) {
        int n = arr.length;

        for(int i = 0; i < n-1; i++) {
            int min = i;
            for(int j = i+1; j < n; j++) {
                if(arr[j] < arr[min]) {
                    min = j;
                }
            }
            int temp = arr[min];
            arr[min] = arr[i];
            arr[i] = temp;
        }

        // Print inside function
        System.out.print("Inside function: ");
        for(int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }
        System.out.println();

        return arr; 
    }

    public static void main(String[] args) {
        int arr[] = {5,4,3,2,1};

        int result[] = Selectionsort(arr);

        System.out.print("In main: ");
        for(int x : result) {
            System.out.print(x + " ");
        }
    }
}

